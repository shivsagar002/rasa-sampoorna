# ==============================================================================
# RASA Sampoorna — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit sensitive keys!

# ------------------------------------------------------------------------------
# App & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PostgreSQL Database & Prisma Connection
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasa_db?schema=public"

# ------------------------------------------------------------------------------
# Authentication (JWT & Session Cookies)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
AUTH_SESSION_EXPIRY_DAYS=30

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# Logistics & Fulfillment (Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="logistics@rasasampoorna.com"
SHIPROCKET_PASSWORD="shiprocket_password_placeholder"

# ------------------------------------------------------------------------------
# Media & Assets Storage (Cloudflare R2 - S3 Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="cloudflare_r2_account_id_placeholder"
R2_ACCESS_KEY_ID="r2_access_key_placeholder"
R2_SECRET_ACCESS_KEY="r2_secret_key_placeholder"
R2_BUCKET_NAME="rasa-products"
R2_PUBLIC_DOMAIN="https://assets.rasasampoorna.com"

# ------------------------------------------------------------------------------
# Transactional & Lifecycle Notifications (Resend)
# ------------------------------------------------------------------------------
# 1. Obtain an API key from https://resend.com/api-keys (starts with re_)
# 2. Add and verify your custom sending domain (e.g. rasasampoorna.com) in Resend DNS settings
# 3. Mode behavior:
#    - If RESEND_API_KEY is unset or "re_placeholder", the system safely routes
#      all emails to the local Sandbox Mock logger without throwing errors.
#    - If RESEND_API_KEY starts with "re_" and is valid, live API dispatch is enabled.
#    - Order persistence never depends on Resend availability (safe durable outbox).
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="orders@rasasampoorna.com"
NOTIFICATIONS_ADMIN_EMAIL="admin@rasasampoorna.com"
