datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum InventoryMovementType {
  RESTOCK
  SALE
  RESERVATION_HOLD
  RESERVATION_RELEASE
  MANUAL_ADJUSTMENT
  DAMAGE_WRITE_OFF
  RETURN_RESTOCK
}

enum InventoryReservationStatus {
  PENDING
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  BANK_TRANSFER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ShipmentStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO_INITIATED
  RTO_DELIVERED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUNDED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// -------------------------------------------------------------
// IDENTITY & USERS
// -------------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  emailVerified           DateTime?
  notificationPreferences String?        // JSON string for patron notification preferences
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      Wishlist?
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  redemptions   CouponRedemption[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(uuid())
  identifier String
  token      String    @unique
  type       String    // PASSWORD_RESET, EMAIL_VERIFY, OTP
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@unique([identifier, type])
  @@index([token])
}

model Address {
  id                   String      @id @default(uuid())
  userId               String
  name                 String
  phone                String
  street               String
  landmark             String?
  city                 String
  state                String
  postalCode           String
  country              String      @default("India")
  type                 AddressType @default(SHIPPING)
  isDefault            Boolean     @default(false)
  deliveryInstructions String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postalCode])
}

// -------------------------------------------------------------
// CATALOG & PRODUCTS
// -------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  imageKey    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Collection {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  description String?
  bannerKey   String?
  isActive    Boolean              @default(true)
  isFeatured  Boolean              @default(false)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  products    ProductCollection[]

  @@index([isActive, isFeatured, sortOrder])
}

model Product {
  id                         String              @id @default(uuid())
  slug                       String              @unique
  name                       String
  sku                        String?             @unique
  tag                        String?             // Handcrafted, Pure Silk, etc.
  categoryId                 String?
  description                String
  material                   String
  fabric                     String?             // Pure Kanjivaram Silk, Chanderi, Tussar, etc.
  weave                      String?             // Zari brocade, Jamdani, Handloom, etc.
  color                      String?             // Crimson Red, Peacock Blue, Emerald Green, etc.
  occasion                   String?             // Bridal, Festive, Evening, Daily Luxury
  style                      String?             // Traditional, Contemporary, Royal
  origin                     String?             // Varanasi, Kanchipuram, Bengal, Maheshwar
  customAttributes           Json?               // Dynamic configurable attributes
  size                       String              @default("Free size")
  availability               String              @default("In Stock")
  detailsList                String[]            // JSON or array of feature strings
  makerNote                  String?
  shippingNote               String?
  status                     ProductStatus       @default(ACTIVE)
  isFeatured                 Boolean             @default(false)
  basePriceInMinorUnits      Int                 // e.g. 450000 = ₹4,500.00
  salePriceInMinorUnits      Int?                // Discounted price if on sale
  originalPriceInMinorUnits  Int?
  currency                   String              @default("INR")
  taxRatePercentage          Float               @default(5.0) // 5% GST on sarees in India
  stockQuantity              Int                 @default(10)
  lowStockThreshold          Int                 @default(2)
  seoTitle                   String?
  seoDescription             String?
  rating                     Float               @default(5.0)
  reviewCount                Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  category                   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                     ProductImage[]
  variants                   ProductVariant[]
  collections                ProductCollection[]
  inventoryMovements         InventoryMovement[]
  wishlistItems              WishlistItem[]
  reviews                    Review[]
  orderItems                 OrderItem[]

  @@index([status, isFeatured])
  @@index([categoryId])
  @@index([basePriceInMinorUnits])
  @@index([createdAt])
  @@index([fabric])
  @@index([occasion])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  r2Key      String   // Cloudflare R2 object key
  url        String   // Public CDN or local URL
  altText    String?
  width      Int?
  height     Int?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                        String                 @id @default(uuid())
  productId                 String
  sku                       String                 @unique
  title                     String                 @default("Default")
  color                     String?
  size                      String?
  priceAdjustmentMinorUnits Int                    @default(0)
  stockQuantity             Int                    @default(0)
  lowStockThreshold         Int                    @default(2)
  isActive                  Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  product                   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems                 CartItem[]
  orderItems                OrderItem[]
  reservations              InventoryReservation[]
  inventoryMovements        InventoryMovement[]

  @@index([productId])
  @@index([stockQuantity])
}

model InventoryMovement {
  id            String                 @id @default(uuid())
  productId     String?
  variantId     String?
  quantityDelta Int                    // positive for additions, negative for reductions
  previousStock Int
  newStock      Int
  type          InventoryMovementType  @default(MANUAL_ADJUSTMENT)
  reason        String?
  reference     String?                // e.g. Order ID, PO number, Admin action
  createdAt     DateTime               @default(now())

  product       Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model InventoryReservation {
  id         String                     @id @default(uuid())
  variantId  String
  quantity   Int
  reference  String                     // Cart ID or Order ID
  status     InventoryReservationStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  variant    ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, status])
  @@index([expiresAt])
}

// -------------------------------------------------------------
// CART & WISHLIST
// -------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @unique
  guestToken String?    @unique
  currency   String     @default("INR")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([guestToken])
}

model CartItem {
  id           String         @id @default(uuid())
  cartId       String
  variantId    String
  quantity     Int            @default(1)
  selectedSize String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Wishlist {
  id         String         @id @default(uuid())
  userId     String?        @unique
  guestToken String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@index([guestToken])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// -------------------------------------------------------------
// ORDERS, CHECKOUT & PAYMENTS
// -------------------------------------------------------------

model Order {
  id                      String                @id @default(uuid())
  orderNumber             String                @unique // e.g. RASA-2026-1001
  idempotencyKey          String?               @unique
  userId                  String?
  guestEmail              String?
  guestPhone              String?
  status                  OrderStatus           @default(PENDING_PAYMENT)
  currency                String                @default("INR")
  subtotalMinorUnits      Int
  shippingFeeMinorUnits   Int                   @default(0)
  discountAmountMinorUnits Int                  @default(0)
  taxAmountMinorUnits     Int                   @default(0)
  totalAmountMinorUnits   Int
  paymentStatus           PaymentStatus         @default(PENDING)
  paymentMethod           PaymentMethod         @default(RAZORPAY)
  razorpayOrderId         String?               @unique
  razorpayPaymentId       String?
  razorpaySignature       String?
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  user                    User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  shippingAddress         OrderAddressSnapshot?
  payments                Payment[]
  refunds                 Refund[]
  shipments               Shipment[]
  returns                 Return[]
  couponRedemptions       CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderAddressSnapshot {
  id         String      @id @default(uuid())
  orderId    String      @unique
  type       AddressType @default(SHIPPING)
  name       String
  phone      String
  street     String
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  createdAt  DateTime    @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                      String          @id @default(uuid())
  orderId                 String
  productId               String?
  variantId               String?
  sku                     String
  productName             String
  productImage            String
  unitPriceMinorUnits     Int
  originalPriceMinorUnits Int?
  quantity                Int
  subtotalMinorUnits      Int
  selectedSize            String?
  metadata                String?         // Serialized JSON for artisan or note info
  createdAt               DateTime        @default(now())

  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                 Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant                 ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returns                 Return[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  paymentProvider  String        @default("RAZORPAY")
  transactionId    String        @unique // Razorpay payment ID
  amountMinorUnits Int
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  rawResponse      String?       // JSON serialized provider payload
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds          Refund[]

  @@index([orderId])
  @@index([status])
}

model Refund {
  id               String       @id @default(uuid())
  orderId          String
  paymentId        String?
  refundId         String       @unique // Razorpay refund ID
  amountMinorUnits Int
  currency         String       @default("INR")
  reason           String?
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// -------------------------------------------------------------
// COUPONS & DISCOUNTS
// -------------------------------------------------------------

model Coupon {
  id                        String             @id @default(uuid())
  code                      String             @unique
  description               String?
  discountType              CouponDiscountType @default(PERCENTAGE)
  discountValueMinorUnits   Int                // e.g. 10 for 10% or 50000 for ₹500
  minOrderAmountMinorUnits  Int?
  maxDiscountMinorUnits     Int?
  usageLimit                Int?
  usageCount                Int                @default(0)
  startsAt                  DateTime?
  expiresAt                 DateTime?
  isActive                  Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  redemptions               CouponRedemption[]

  @@index([code, isActive])
}

model CouponRedemption {
  id                      String   @id @default(uuid())
  couponId                String
  orderId                 String
  userId                  String?
  discountAmountMinorUnits Int
  createdAt               DateTime @default(now())

  coupon                  Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([orderId])
}

// -------------------------------------------------------------
// LOGISTICS, SHIPPING & RETURNS
// -------------------------------------------------------------

model Shipment {
  id                    String          @id @default(uuid())
  orderId               String
  carrier               String          @default("SHIPROCKET")
  shiprocketOrderId     String?
  shiprocketShipmentId  String?
  awbCode               String?         @unique
  trackingNumber        String?
  trackingUrl           String?
  status                ShipmentStatus  @default(LABEL_CREATED)
  dispatchedAt          DateTime?
  estimatedDeliveryAt   DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents        TrackingEvent[]

  @@index([orderId])
  @@index([status])
  @@index([awbCode])
}

model TrackingEvent {
  id         String   @id @default(uuid())
  shipmentId String
  status     String
  location   String?
  activity   String
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
}

model Return {
  id                      String       @id @default(uuid())
  orderId                 String
  orderItemId             String
  reason                  String
  status                  ReturnStatus @default(REQUESTED)
  refundAmountMinorUnits  Int?
  requestedAt             DateTime     @default(now())
  processedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  order                   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem               OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// -------------------------------------------------------------
// REVIEWS & CMS CONTENT
// -------------------------------------------------------------

model Review {
  id                 String       @id @default(uuid())
  productId          String
  userId             String?
  authorName         String
  rating             Int          @default(5)
  title              String?
  comment            String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([rating])
}

model CmsContent {
  id        String   @id @default(uuid())
  slug      String   @unique // e.g. corporate-packages, brand-philosophy
  title     String
  section   String   // homepage, corporate, faq, legal
  payload   String   // JSON string of structured content
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, isActive])
}

// -------------------------------------------------------------
// AUDIT LOGS, NOTIFICATIONS & WEBHOOK EVENTS
// -------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid())
  userId    String?
  channel   NotificationChannel @default(EMAIL)
  recipient String              // Email address or phone number
  subject   String?
  body      String
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recipient, status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // e.g. PRODUCT_UPDATE, ORDER_STATUS_CHANGE, REFUND_ISSUED
  entity    String   // Product, Order, User
  entityId  String
  details   String?  // JSON diff or metadata
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id             String             @id @default(uuid())
  provider       String             // RAZORPAY, SHIPROCKET
  eventType      String             // payment.captured, order.dispatched
  idempotencyKey String             @unique
  payload        String             // Raw JSON
  status         WebhookEventStatus @default(PENDING)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@index([provider, eventType])
  @@index([status])
}

model CorporateInquiry {
  id            String   @id @default(uuid())
  name          String
  organization  String
  email         String
  phone         String
  quantityRange String
  budget        String
  message       String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
